# ==============================================================================
# Website Design Automation System — Environment Configuration Template
# Copy this file to `backend/.env` and configure for your environment.
# ==============================================================================

# AI Provider Selection
# Options:
#   - 'ollama'     : Exclusively use local Ollama instance (no external API calls or keys required)
#   - 'openrouter' : Use cloud OpenRouter API (requires OPENROUTER_API_KEY)
#   - 'mock'       : Deterministic offline mock provider for testing and CI/CD
#   - 'auto'       : Automatically detect (prefers healthy Ollama, falls back to OpenRouter, then mock)
AI_PROVIDER=auto

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Recommended local models tested for 4GB-8GB VRAM:
# - qwen2.5:3b          (Fast, low VRAM ~2.0GB, excellent structured JSON)
# - qwen2.5:7b          (Comprehensive, ~4.7GB, high instruction following)
# - nemotron-mini:4b    (NVIDIA compact model, ~2.7GB)
OLLAMA_MODEL=qwen2.5:3b

# Hosted OpenRouter Configuration (Optional if using Ollama)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_FALLBACK_MODELS=anthropic/claude-3.5-sonnet,openai/gpt-4.1,deepseek/deepseek-v3.2

# Generation & Resilience Settings
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=3
AI_RETRY_DELAY=1.5
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096

# Django Settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

